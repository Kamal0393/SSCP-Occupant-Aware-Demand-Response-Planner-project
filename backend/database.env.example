# Local default is SQLite. Use the PostgreSQL URL below for deployment.
DATABASE_URL=sqlite:///./sscp_dr_planner.db
DATABASE_ECHO=false
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
OVERRIDE_AUTH_TOKEN=replace-with-a-private-operator-token

# PostgreSQL example:
# DATABASE_URL=postgresql://sscp_user:sscp_pass@localhost:5432/sscp_dr_planner
